#!/usr/bin/env bash
# Prepare the tree for a release: the pre-bump hook of cog.toml.
#
# usage: tools/release-prepare NEW_VERSION
#
# `cog bump` runs this with the version it is about to tag, then commits what
# changed and creates the tag. For NEW_VERSION and the version pyproject.toml
# still names (OLD) it sets the version in:
#   - pyproject.toml, eb_staged_rebuild/__init__.py, build.zig.zon and
#     zig/main.zig, which the release workflow compares with the tag;
#   - README.md and docs/intro/install.md: the download command and the
#     `--version` line.
#
# CHANGELOG.md is written by hand in this repository. The script refuses to
# go on until it has a `## NEW_VERSION` section, so write that section in a
# commit before the bump.
#
# A refused run can leave edited files behind; `git checkout -- .` puts the
# tree back.
set -euo pipefail

new=${1:?usage: tools/release-prepare NEW_VERSION}
cd "$(dirname "${BASH_SOURCE[0]}")/.."

die() { echo "release-prepare: $*" >&2; exit 2; }

# set_in FILE SED_EXPRESSION...: edit FILE, and refuse a FILE the expressions
# leave unchanged, so a version string that moved fails the bump instead of
# being skipped.
set_in() {
    local file=$1 before
    shift
    before=$(sha256sum < "${file}")
    sed -i -E "$@" "${file}"
    [ "${before}" != "$(sha256sum < "${file}")" ] || die "${file} does not name ${old} where expected"
}

[[ ${new} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "'${new}' is not X.Y.Z"
old=$(sed -n 's/^version = "\([0-9.]*\)"$/\1/p' pyproject.toml | head -n 1)
[ -n "${old}" ] || die "pyproject.toml names no version"
[ "${old}" != "${new}" ] || die "pyproject.toml already names ${new}"
old_re=${old//./\\.}
grep -q -E "^## \[?${new//./\\.}(\]| |\$)" CHANGELOG.md || die "CHANGELOG.md has no section for ${new}"

set_in pyproject.toml "0,/^version = /s/^(version = )\"${old_re}\"\$/\1\"${new}\"/"
set_in eb_staged_rebuild/__init__.py "s/^(__version__ = )\"${old_re}\"\$/\1\"${new}\"/"
set_in build.zig.zon "s/^( *\.version = )\"${old_re}\",\$/\1\"${new}\",/"
set_in zig/main.zig "s/^(pub const version = )\"${old_re}\";\$/\1\"${new}\";/"
set_in README.md "s/^(v=)${old_re}( arch=)/\1${new}\2/"
set_in docs/intro/install.md \
    -e "s/^(v=)${old_re}( arch=)/\1${new}\2/" \
    -e "s/^(eb-staged-rebuild )${old_re}\$/\1${new}/"

echo "release-prepare: ${old} -> ${new}"
git status --short | awk '{print $1}' | sort | uniq -c
